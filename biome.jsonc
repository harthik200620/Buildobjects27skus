{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",

  // One tool for formatting, linting and import order. It replaced no previous setup: before
  // this there was no linter at all, which is how `void x;` statements and dead `eslint-disable`
  // comments pointing at a linter that did not exist ended up in the tree.
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },

  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/.turbo",
      "!**/dist",
      "!infra/bin",
      // Everything under storage/ and assets/ is produced by a run, not written by hand.
      "!storage",
      "!assets",
      // Regenerated by `next build` on every run — formatting it is a fight we lose each time.
      "!apps/web/next-env.d.ts",
      // Generated migrations and hand-maintained data fixtures.
      "!packages/db/drizzle",
      "!services/pipeline/data",
      "!services/pipeline/registry",
      "!pnpm-lock.yaml"
    ]
  },

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    // Wide, because this codebase leans on dense single-line guards and object literals and
    // reads worse when they are exploded. p95 of the existing tree was 151 columns.
    "lineWidth": 160,
    "lineEnding": "lf"
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },

  // The design system is Tailwind v4: @theme, @apply and @layer are first-class here, not typos.
  "css": {
    "parser": { "tailwindDirectives": true }
  },

  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },

  "linter": {
    "enabled": true,
    "rules": {
      // `recommended: true` is deprecated in Biome 2.5 and prints a notice on every run.
      "preset": "recommended",

      "correctness": {
        // A function rebuilt every render inside a dep array re-fires the effect every render.
        // That shipped twice here: one /api/serviceability request per render of the buy box,
        // and a scroll listener re-attached on every render of every product rail.
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            // This project's own hooks, declared so the rule knows what is already stable.
            // Without these it demands `videoRef.current` in dependency arrays, which React
            // explicitly does not want: a ref is a mutable box, not a reactive value, and
            // listing it neither re-runs the effect nor survives the ref being null.
            "hooks": [
              { "name": "useCameraStream", "stableResult": ["videoRef", "start", "stop"] },
              { "name": "useOrientation", "stableResult": true },
              { "name": "useDismiss", "stableResult": true }
            ]
          }
        },
        "useHookAtTopLevel": {
          "level": "error",
          "options": {
            // WebGL context methods, not React hooks. They only match because of `use*`.
            "ignore": ["useProgram", "useFramebuffer"]
          }
        },
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "noUnsafeOptionalChaining": "error"
      },

      "suspicious": {
        "noExplicitAny": "error",
        "noImplicitAnyLet": "error",
        "noArrayIndexKey": "error",
        // console.warn and console.error are the app's error channel; console.log is not.
        "noConsole": { "level": "error", "options": { "allow": ["warn", "error"] } },

        // OFF: matches any local function named `fit`, of which the 3D normaliser has one.
        "noFocusedTests": "off",
        // OFF: `while ((m = re.exec(s)))` and `(map[k] ??= {})` are the idiomatic forms. The
        // rule guards a footgun that does not exist at any of the six sites here.
        "noAssignInExpressions": "off",
        // OFF: `\x00-\x7F` in the script detector is the point — it asks "is this ASCII".
        "noControlCharactersInRegex": "off",
        "noDocumentCookie": "off"
      },

      "style": {
        "useConst": "error",
        "useTemplate": "error",
        "useImportType": "error",
        "useExponentiationOperator": "error",

        // OFF: 144 sites, nearly all `arr[0]!` after a length check. Worth revisiting behind a
        // real audit, not worth 144 mechanical edits today.
        "noNonNullAssertion": "off",
        "noParameterAssign": "off",
        "noDescendingSpecificity": "off"
      },

      "complexity": {
        "noForEach": "off",
        "useLiteralKeys": "off",
        // OFF: confined to the print stylesheet in legacy.css, where it is the correct tool.
        "noImportantStyles": "off"
      },

      "performance": {
        "noDelete": "off",
        // OFF: the pipeline pre-derives exact renditions (thumb/card/gallery/zoom) and
        // next.config points next/image at a custom loader precisely so nothing is re-encoded.
        // A raw <img> on an already-correct rendition is the intended path, not an oversight.
        "noImgElement": "off"
      },

      "a11y": {
        // OFF: a segmented control built from role="group" + aria-pressed buttons is what every
        // headless UI library emits. <fieldset>/<legend> carries layout behaviour that fights it.
        "useSemanticElements": "off"
      }
    }
  },

  "overrides": [
    {
      // CLI entry points and tests: stdout IS the interface, and env vars come from the shell.
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/test/**",
        "**/scripts/**",
        "infra/**",
        "services/pipeline/**",
        "packages/db/src/*.ts",
        "packages/assets3d/src/**",
        "packages/assets3d/tools/**"
      ],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off", "noUndeclaredEnvVars": "off" },
          "correctness": { "noUnsafeOptionalChaining": "off" }
        }
      }
    },
    {
      // Third-party WebGL renderer kept verbatim — see DECISIONS.md, 2026-08-25. `gl.useProgram`
      // is not a React hook, and its dense local style is not ours to restyle.
      "includes": ["apps/web/lib/stitch/**"],
      "linter": {
        "rules": {
          "correctness": { "useHookAtTopLevel": "off", "noUnusedVariables": "off" },
          "suspicious": { "useIterableCallbackReturn": "off" }
        }
      }
    },
    {
      // A labelled chart: the <svg> carries role="img" and an aria-label with the totals, and
      // the legend beneath repeats every number as text. Hover only emphasises a slice.
      "includes": ["apps/web/components/estimate/Donut.tsx"],
      "linter": { "rules": { "a11y": { "noStaticElementInteractions": "off" } } }
    }
  ]
}
