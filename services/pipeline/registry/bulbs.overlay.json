{
  "$comment": "The calendar sheet lists the Bulbs attributes verbatim but says nothing about data types, units or filters. This overlay adds that for the attributes a buyer acts on; everything else stays text, non-filterable, importance 4. Keys = sheet labels slugified (first occurrence wins across groups). Mandatory keys that the sheet lacks are appended.",
  "overrides": {
    "wattage":                { "data_type": "number", "unit": "W",      "is_filterable": true, "filter_widget": "range", "filter_order": 1, "importance_rank": 1, "show_in_key_specs": true, "show_on_card": true, "compare": true, "synonyms": ["watt", "power", "వాట్", "वाट"] },
    "lumens":                 { "data_type": "number", "unit": "lm",     "is_filterable": true, "filter_widget": "range", "filter_order": 2, "importance_rank": 1, "show_in_key_specs": true, "show_on_card": true, "compare": true, "synonyms": ["brightness", "luminous flux", "ప్రకాశం"] },
    "colour_temperature":     { "data_type": "number", "unit": "K",      "is_filterable": true, "filter_widget": "range", "filter_order": 3, "importance_rank": 1, "show_in_key_specs": true, "show_on_card": true, "compare": true, "synonyms": ["cct", "warm white", "cool daylight", "color temperature"] },
    "base_type":              { "data_type": "enum",   "unit": null, "enum_values": ["B22", "E27", "E14", "GU10", "B15"], "is_filterable": true, "filter_widget": "chips", "filter_order": 4, "importance_rank": 1, "show_in_key_specs": true, "compare": true, "synonyms": ["holder", "cap", "pin", "b22", "e27"] },
    "colour_rendering_index": { "data_type": "number", "unit": "Ra",     "is_filterable": true, "filter_widget": "range", "filter_order": 6, "importance_rank": 2, "show_in_key_specs": true, "compare": true, "synonyms": ["cri"] },
    "operating_life":         { "data_type": "number", "unit": "h",      "is_filterable": true, "filter_widget": "range", "filter_order": 7, "importance_rank": 2, "show_in_key_specs": true, "compare": true, "synonyms": ["life", "lifespan", "hours", "burning hours"] },
    "energy_rating":          { "data_type": "text",   "is_filterable": true, "filter_widget": "checkbox", "filter_order": 5, "importance_rank": 2, "show_in_key_specs": true, "compare": true, "synonyms": ["bee star", "star rating"] },
    "warranty_months":        { "data_type": "number", "unit": "months", "is_filterable": true, "filter_widget": "range", "filter_order": 9, "importance_rank": 2, "show_in_key_specs": true, "compare": true, "synonyms": ["warranty", "guarantee", "వారంటీ", "वारंटी"] },
    "dimmability":            { "data_type": "boolean", "is_filterable": true, "filter_widget": "toggle", "filter_order": 8, "importance_rank": 2, "compare": true, "synonyms": ["dimmable", "dimmer"] },
    "beam_angle":             { "data_type": "number", "unit": "°", "importance_rank": 2, "compare": true },
    "voltage":                { "data_type": "text",   "unit": "V AC", "importance_rank": 2, "compare": true },
    "frequency":              { "data_type": "number", "unit": "Hz", "importance_rank": 4 },
    "power_factor":           { "data_type": "number", "unit": null, "importance_rank": 2, "compare": true },
    "efficacy":               { "data_type": "number", "unit": "lm/W", "importance_rank": 2, "compare": true },
    "luminous_flux":          { "data_type": "number", "unit": "lm", "importance_rank": 3 },
    "shape":                  { "data_type": "enum",   "enum_values": ["A-shape", "Candle", "Globe", "Golf ball", "Reflector", "T-shape"], "is_filterable": true, "filter_widget": "checkbox", "filter_order": 10, "importance_rank": 2, "compare": true },
    "bulb_type":              { "data_type": "text",   "importance_rank": 2 },
    "led_type":               { "data_type": "text",   "importance_rank": 3 },
    "smart_compatibility":    { "data_type": "text",   "importance_rank": 3 },
    "overall_height":         { "data_type": "number", "unit": "mm", "importance_rank": 2, "compare": true },
    "overall_diameter":       { "data_type": "number", "unit": "mm", "importance_rank": 2, "compare": true },
    "bulb_diameter":          { "data_type": "number", "unit": "mm", "importance_rank": 3 },
    "base_diameter":          { "data_type": "number", "unit": "mm", "importance_rank": 3 },
    "product_weight":         { "data_type": "number", "unit": "g",  "importance_rank": 3 },
    "switching_cycles":       { "data_type": "number", "unit": "cycles", "importance_rank": 3 },
    "flicker_level":          { "data_type": "text",   "importance_rank": 3 },
    "power_consumption":      { "data_type": "number", "unit": "W", "importance_rank": 3 },
    "luminous_intensity":     { "data_type": "number", "unit": "cd", "importance_rank": 4 },
    "operating_temperature":  { "data_type": "text",   "unit": "°C", "importance_rank": 3 },
    "storage_temperature":    { "data_type": "text",   "unit": "°C", "importance_rank": 4 },
    "ambient_temperature":    { "data_type": "text",   "unit": "°C", "importance_rank": 3 },
    "rated_current":          { "data_type": "number", "unit": "mA", "importance_rank": 3 },
    "input_current":          { "data_type": "number", "unit": "mA", "importance_rank": 4 },
    "inrush_current":         { "data_type": "text",   "importance_rank": 4 },
    "ip_rating":              { "data_type": "text",   "importance_rank": 2, "compare": true },
    "residential":            { "data_type": "boolean", "importance_rank": 3 },
    "commercial":             { "data_type": "boolean", "importance_rank": 3 },
    "office":                 { "data_type": "boolean", "importance_rank": 4 },
    "outdoor":                { "data_type": "boolean", "importance_rank": 3 },
    "is_16102":               { "data_type": "text",   "importance_rank": 1, "compare": true },
    "bis":                    { "data_type": "text",   "importance_rank": 1 },
    "bee":                    { "data_type": "text",   "importance_rank": 2 },
    "rohs":                   { "data_type": "text",   "importance_rank": 3 },
    "lm_79":                  { "data_type": "text",   "importance_rank": 4 },
    "lm_80":                  { "data_type": "text",   "importance_rank": 4 },
    "surface_finish":         { "data_type": "text",   "importance_rank": 3 },
    "socket_compatibility":   { "data_type": "text",   "importance_rank": 2 },
    "voltage_compatibility":  { "data_type": "text",   "importance_rank": 3 },
    "dimmer_compatibility":   { "data_type": "text",   "importance_rank": 3 },
    "mounting_orientation":   { "data_type": "text",   "importance_rank": 3 },
    "individual_packaging":   { "data_type": "text",   "importance_rank": 3 },
    "carton_box":             { "data_type": "text",   "importance_rank": 4 },
    "product_price":          { "data_type": "number", "unit": "₹", "importance_rank": 2 },
    "retail_price":           { "data_type": "number", "unit": "₹", "importance_rank": 3 },
    "minimum_order_quantity": { "data_type": "number", "unit": "pcs", "importance_rank": 3 },
    "availability":           { "data_type": "text",   "importance_rank": 3 },
    "warranty_period":        { "data_type": "text",   "importance_rank": 2 },
    "model_number":           { "data_type": "text",   "importance_rank": 1 },
    "country_of_origin":      { "data_type": "text",   "importance_rank": 2 }
  },
  "append": [
    { "key": "dim_w_mm",      "group": "dimensions", "label": "Width",          "data_type": "number", "unit": "mm", "importance_rank": 2, "display_order": 900 },
    { "key": "dim_h_mm",      "group": "dimensions", "label": "Height",         "data_type": "number", "unit": "mm", "importance_rank": 2, "display_order": 901 },
    { "key": "dim_d_mm",      "group": "dimensions", "label": "Depth",          "data_type": "number", "unit": "mm", "importance_rank": 2, "display_order": 902 },
    { "key": "net_weight_kg", "group": "physical",   "label": "Net weight",     "data_type": "number", "unit": "kg", "importance_rank": 3, "display_order": 900 },
    { "key": "is_standard",   "group": "standards",  "label": "Governing standard", "data_type": "text", "importance_rank": 1, "display_order": 0, "compare": true },
    { "key": "hsn_code",      "group": "commercial", "label": "HSN code",       "data_type": "text",   "importance_rank": 2, "display_order": 900 },
    { "key": "warranty_months", "group": "warranty", "label": "Warranty",       "data_type": "number", "unit": "months", "is_filterable": true, "filter_widget": "range", "filter_order": 9, "importance_rank": 2, "display_order": 0, "compare": true, "synonyms": ["warranty", "guarantee", "వారంటీ", "वारंटी"] }
  ],
  "key_specs": ["wattage", "lumens", "colour_temperature", "base_type", "colour_rendering_index", "operating_life", "energy_rating", "warranty_months"]
}
