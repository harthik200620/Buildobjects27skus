# ── data stores ──────────────────────────────────────────────────────────────
# MySQL 8 (local: infra/local.mjs; docker: infra/docker-compose.yml; AWS: RDS endpoint)
DATABASE_URL=mysql://root:buildo@localhost:3306/buildobjects
# Or, where a host hands you the parts instead of a URL (Render's Blueprint does): leave
# DATABASE_URL unset and set these — packages/db composes the URL from them.
# DB_HOST=          DB_PORT=3306      DB_USER=root
# DB_PASSWORD=      DB_NAME=buildobjects
# Meilisearch (local binary or container; AWS: ECS/EC2 or Meilisearch Cloud URL)
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=buildo-local
# Redis for BullMQ (local: WSL redis-server; docker: redis:7; AWS: ElastiCache)
REDIS_URL=redis://127.0.0.1:6379
# auto | bullmq | local — `auto` uses BullMQ when Redis answers, else the MySQL-backed local driver
QUEUE_DRIVER=auto

# ── media ────────────────────────────────────────────────────────────────────
# Local disk root for the MediaStore (S3-shaped keys). Relative paths are repo-root relative for
# every process (pipeline and apps/web alike). On AWS set MEDIA_STORE=s3 + bucket.
MEDIA_ROOT=./storage/media
# Public base URL the frontend prefixes to every media key. Local: served by apps/web. AWS: CloudFront origin.
MEDIA_BASE_URL=/media
MEDIA_STORE=local
# S3_BUCKET=
# S3_REGION=ap-south-1

# ── models ───────────────────────────────────────────────────────────────────
# Pipeline extraction / verification / description agent. Empty = curated fixture provider (services/pipeline/data/curated).
ANTHROPIC_API_KEY=
# AR photo mode: scene gate + generative composite. Empty = deterministic mock provider (clearly labelled in the UI).
GEMINI_API_KEY=
# Optional monocular depth (Depth Anything V2). Empty = geometric-prior depth estimator.
REPLICATE_API_TOKEN=

# ── app ──────────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-in-production
NEXT_PUBLIC_SITE_NAME=Build Objects

# ── model overrides (optional) ───────────────────────────────────────────────
# PIPELINE_MODEL=claude-opus-5          # extraction / verification / fill / describe
# DRAWING_MODEL=claude-opus-5           # calculator drawing reader
# GEMINI_VISION_MODEL=gemini-2.5-flash  # AR scene understanding
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image  # AR generative composite

# ── Gemini platform (packages/llm) ───────────────────────────────────────────
# Model picks per kind. Unset = the first entry of the preference list that models.list reports for
# the key (pro: gemini-3.1-pro-preview → gemini-3-pro-preview → gemini-2.5-pro; flash/vision/segment:
# gemini-3-flash-preview → gemini-2.5-flash; image: gemini-3.1-flash-image-preview → gemini-2.5-flash-image),
# discovered once per day and cached in storage/reports/gemini-models.json. Set an id to pin it.
# GEMINI_PIPELINE_MODEL=              # 'pro' kind — spec extraction from pages/PDFs
# GEMINI_FAST_MODEL=                  # 'flash' kind — verify, price, fill, describe, canonicalise, estimate review
# GEMINI_VISION_MODEL=                # 'vision' kind — image judge, AR scene understanding, 3D-match judge
# GEMINI_IMAGE_MODEL=                 # 'image' kind — AR generative composite
# GEMINI_SEGMENT_MODEL=               # 'segment' kind — segmentation masks (cut-outs, AR surfaces)
# GEMINI_DRAWING_MODEL=               # calculator drawing reader (defaults to the 'pro' pick)
# GEMINI_THINKING=                    # off | low | default — overrides the per-intent thinking policy (unset = policy)
# GEMINI_GROUNDED_STRICT_JSON=1       # 0 = never try JSON mode together with Google Search; go straight to schema-in-prompt
# GEMINI_CONCURRENCY=4                # process-wide in-flight Gemini calls
# GEMINI_RPM=30                       # process-wide requests per minute
# GEMINI_TIMEOUT_MS=120000            # per-call deadline (AbortSignal.timeout, combined with the caller signal)
# GEMINI_DAILY_CALL_CAP=2000          # logical calls per UTC day per process; seeded from storage/reports/llm-usage.jsonl
# GEMINI_PRICE_JSON=                  # {"gemini-2.5-flash":{"input":0.3,"output":2.5}} USD per 1M tokens — replaces the built-in *estimated* table used by llm-usage.jsonl

# ── pipeline tuning ──────────────────────────────────────────────────────────
# PIPELINE_CONCURRENCY=6
# PIPELINE_POLITENESS_MS=1500
# PIPELINE_FETCH_TIMEOUT_MS=25000

# ── paths ────────────────────────────────────────────────────────────────────
# ASSETS_3D_ROOT=../../assets/3d        # relative to apps/web at runtime (GLBs + manifest.json)
# NEXT_PUBLIC_MEDIA_BASE_URL=/media     # browser-side media base (CloudFront on AWS)

# ── scale proof ──────────────────────────────────────────────────────────────
# SCALE_SEED=1                          # allows pnpm scale:seed to write synthetic SKUs (or pass --yes)

# ── 3D photoreal pipeline (pnpm assets:3d:photoreal) ────────────────────────
# Image-to-3D providers. Empty = no photoreal run (textured / flat parametric models stay in place, labelled in the manifest).
MESHY_API_KEY=
TRIPO_API_KEY=
# auto | meshy | tripo — auto picks the first provider with a key; the other one is the last-resort retry.
PHOTOREAL_PROVIDER=auto
# MESHY_MODEL=meshy-7                   # Meshy ai_model for image-to-3d / multi-image-to-3d
# TRIPO_MODEL_VERSION=v2.5-20250123     # Tripo model_version for image_to_model / multiview_to_model
# Hard ceiling on the estimated spend of one run (USD); --max-spend overrides per run.
PHOTOREAL_MAX_SPEND_USD=30

# ── calculator AI ────────────────────────────────────────────────────────────
# Drawing reader model (unset = the 'pro' pick); the AI review uses the 'flash' pick (GEMINI_FAST_MODEL).
# GEMINI_DRAWING_MODEL=
# AI review (POST /api/estimate/refine): calls per window per IP + session as "calls/seconds", and reviews per UTC day per process.
REFINE_RATE_LIMIT=5/600
REFINE_DAILY_CAP=200
