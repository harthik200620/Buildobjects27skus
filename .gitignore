node_modules/
.next/
dist/
.turbo/
*.tsbuildinfo
.env
.env.local

# local infra (binaries + data live here, never in git)
infra/bin/
infra/data/
infra/run/

# Everything under storage/ is produced by a run. Most of it is not source and stays out —
# raw page captures, coverage, screenshots, lighthouse and scale results.
#
# storage/media is the exception and is tracked: it is what the storefront actually serves
# (product photographs, the generated category art, the estimator's house renders), it is
# content-addressed so it never churns, and a clone without it renders a catalogue of empty
# frames. Regenerating it costs a Meshy and a Gemini bill; committing it costs disk.
storage/*
!storage/media
storage/media/**/*.tmp
assets/3d/_selftest/

# scale-test artefacts
packages/db/scale-report*.json

# Generated placeholder models (`pnpm assets:3d`); a real model at assets/3d/{SKU}.glb always
# wins over the placeholder of the same name. These are tracked: seven SKUs still have no
# photoreal build, a CDN cannot fall back to a directory the way the route handler does, and
# 1.3 MB is cheaper than a 3D viewer that 404s for a quarter of the catalogue.

# What Meshy/Tripo returned, byte for byte, before normalisation — 19 MB for one SKU and
# nothing reads it back. The deliverable is assets/3d/{SKU}.glb; assets/3d/jobs.json is the
# ledger that stops the provider being paid twice for the same inputs, and that IS tracked.
assets/3d/photoreal/raw/

# The catalogue database dump. The compressed one is tracked — it is what a fresh deployment
# restores into an empty database on first boot (packages/db/src/bootstrap.ts), it is 177 KB, and
# it holds schema for every table but rows for the catalogue tables only: no users, no sessions,
# no phone numbers. The uncompressed copy beside it is a build artefact of `pnpm db:dump`.
infra/seed/*
!infra/seed/buildobjects.sql.gz

# Staged for the CDN by `apps/web/scripts/stage-media.mts` at build time — hard links to
# storage/media and assets/3d, which are the tracked originals. Deriving it on every build is
# what lets Vercel serve 309 MB of photographs and models statically without a second copy in git.
apps/web/public/media/
apps/web/public/3d/
