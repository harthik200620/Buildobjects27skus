node_modules/
.next/
dist/
.turbo/
*.tsbuildinfo
.env
.env.local

# local infra (binaries + data live here, never in git)
infra/bin/
infra/data/
infra/run/

# Everything under storage/ is produced by a run. Most of it is not source and stays out —
# raw page captures, coverage, screenshots, lighthouse and scale results.
#
# storage/media is the exception and is tracked: it is what the storefront actually serves
# (product photographs, the generated category art, the estimator's house renders), it is
# content-addressed so it never churns, and a clone without it renders a catalogue of empty
# frames. Regenerating it costs a Meshy and a Gemini bill; committing it costs disk.
storage/*
!storage/media
storage/media/**/*.tmp
assets/3d/_selftest/

# scale-test artefacts
packages/db/scale-report*.json

# generated placeholder models (pnpm assets:3d); real models in assets/3d/{SKU}.glb are kept
assets/3d/placeholders/

# What Meshy/Tripo returned, byte for byte, before normalisation — 19 MB for one SKU and
# nothing reads it back. The deliverable is assets/3d/{SKU}.glb; assets/3d/jobs.json is the
# ledger that stops the provider being paid twice for the same inputs, and that IS tracked.
assets/3d/photoreal/raw/

# The catalogue database dump. Removed: the storefront no longer needs a database at all —
# apps/web/data/catalogue is a 1 MB snapshot taken from the live loaders, and every loader falls
# back to it. Regenerate with `npx tsx apps/web/scripts/export-catalogue.mts`.
infra/seed/
